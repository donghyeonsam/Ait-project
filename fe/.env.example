VITE_BE_API_URL=/backend
VITE_BE_PROXY_TARGET=http://localhost:8080
# 게시글 이미지·첨부파일 등 업로드 파일이 정적으로 서빙되는 EC2 도메인. 미설정 시 배포 도메인을 기본값으로 사용합니다.
VITE_UPLOADS_URL=https://i15d202.p.ssafy.io/uploads
# 별도 WebSocket 서버를 사용할 때만 설정합니다. 미설정 시 개발 환경은 /backend 프록시를 사용합니다.
# VITE_WS_URL=https://api.example.com
# 표정 인식용 MediaPipe 모델 파일 경로. 미설정 시 Google CDN 기본값을 사용합니다.
# VITE_FACE_LANDMARKER_MODEL_URL=
VITE_GITHUB_APP_INSTALL_URL=
VITE_GOOGLE_CLIENT_ID=
# 로컬(localhost)용 깃허브 OAuth App client ID. 배포 환경은 Vercel에 별도 client ID를 설정합니다.
VITE_GITHUB_CLIENT_ID=
# 특정 계정의 1번 질문과 첫 꼬리질문을 시연용 문항으로 교체할 때 설정합니다.
VITE_DEMO_INTERVIEW_EMAIL=
