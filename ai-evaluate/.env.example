# 복사해서 사용:  cp .env.example .env

APP_ENV=development

# ── Celery / Redis (선택 사항) ──
# 기본 구성(동기 방식)에서는 쓰지 않는다. 아래 두 줄은 큐 방식을 켤 때만 필요하다.
#   docker compose --profile queue up -d
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── 스토리지 ──
# local : api 와 worker 가 공유 볼륨을 쓰는 방식 (단일 VM + docker compose)
# s3    : 컨테이너가 서로 다른 노드에 뜰 수 있는 환경(ECS/k8s)에서 필요
STORAGE_BACKEND=local
MEDIA_DIR=/app/media

# ── 표정 분석 임계값 ──
# 우리 촬영 데이터를 보고 반드시 튜닝해야 하는 경험적 기본값이다.
BLINK_EAR_THRESHOLD=0.21
GAZE_DEVIATION_THRESHOLD=0.15

# 프론트가 보내는 프레임 수 상한 (과도한 페이로드 방어)
MAX_FACE_FRAMES=3000

# ── 음성 분석 ──
# teacher(wav2vec2)와 동일 조건을 맞추기 위한 리샘플링 레이트
VOICE_SAMPLE_RATE=16000
# Praat 피치/지터 탐색 범위 (사람 말소리 F0 범위)
PRAAT_PITCH_FLOOR=75
PRAAT_PITCH_CEILING=400

# 음성 분석 동시 실행 개수 제한. LiveKit(화상면접)과 같은 서버에 올린다면 올리지 말 것.
VOICE_CONCURRENCY=2
# 음성 분석 하나가 이 시간을 넘기면 포기(초)
VOICE_TIMEOUT_SEC=120
# 받아줄 소리 파일 최대 크기(바이트). 기본 30MB
MAX_AUDIO_BYTES=31457280

VOICE_IDEAL_TENSION=0.4
VOICE_TENSION_SCORE_WIDTH=0.35