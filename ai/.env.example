# ── GMS LLM ──
GMS_KEY=your-gms-api-key-here
GMS_BASE_URL=https://gms.ssafy.io/gmsapi/api.openai.com/v1
GMS_MODEL=gpt-5.4-mini
# ── Chroma DB ──
# 로컬 영속 저장 경로 (docker volume 으로 마운트됨)
CHROMA_PERSIST_DIR=/app/chroma_data
CHROMA_COLLECTION=user_documents

# ── 임베딩 모델 (한국어) ──
EMBEDDING_MODEL=jhgan/ko-sroberta-multitask

# ── 면접 규칙 ──
QUESTION_COUNT=10
MAX_FOLLOWUP_PER_QUESTION=2
RAG_TOP_K=5

# ── 서버 ──
APP_ENV=development
